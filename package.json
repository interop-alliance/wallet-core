{
  "name": "@interop/wallet-core",
  "description": "Shared wallet-domain logic (WAS sync engine core and wallet Space layout contracts) for Interop wallet apps.",
  "version": "0.58.0",
  "type": "module",
  "scripts": {
    "build": "pnpm run clear && tsc",
    "clear": "rimraf dist/*",
    "dev": "vite",
    "fix": "eslint --fix src test && pnpm run format",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"*.md\"",
    "lint": "eslint src test",
    "prepare": "pnpm run build",
    "rebuild": "pnpm run clear && pnpm run build",
    "typecheck": "tsc -p tsconfig.dev.json",
    "test": "pnpm run fix && pnpm run lint && pnpm run typecheck && pnpm run test:node && pnpm run test:dist",
    "test:browser": "playwright test",
    "test:dist": "pnpm run build && ! grep -rl @interop/logger dist",
    "test:node": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@interop/data-integrity-core": "^8.7.1",
    "@interop/data-integrity-proof": "^3.4.5",
    "@interop/did-method-webvh": "^5.6.0",
    "@interop/ed25519-signature": "^7.1.4",
    "@interop/ed25519-verification-key": "^8.0.4",
    "@interop/ezcap": "^7.4.4",
    "@interop/security-document-loader": "^10.0.4",
    "@interop/social-core": "^0.8.1",
    "@interop/storage-core": "^0.9.1",
    "@interop/vc": "^11.0.7",
    "@interop/vh-resource-log": "^0.4.1",
    "@interop/was-client": "^0.45.0",
    "@interop/webkms-client": "^14.7.4",
    "@interop/x25519-key-agreement-key": "^5.2.2",
    "@noble/ciphers": "^2.3.0",
    "@noble/hashes": "^2.3.0",
    "@scure/base": "^2.3.0",
    "byoe-context": "^0.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@interop/logger": "^0.2.0",
    "@playwright/test": "^1.60.0",
    "@types/node": "^26.0.1",
    "@vitest/coverage-v8": "^4.1.7",
    "eslint": "^10.4.0",
